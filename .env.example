# Sem DATABASE_URL o sistema usa SQLite (arquivo local "biblioteca.db" na raiz do projeto,
# ou o caminho em DB_SQLITE_PATH) — é o padrão, não precisa de nenhuma instalação extra.
# Pra usar PostgreSQL em vez disso, descomente e preencha a linha abaixo:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/biblioteca

PORT=3303
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Opcional — endereço de um servidor que informa a versão mais recente disponível (checado
# a cada login, só por administradores). Em branco, o sistema nunca verifica nada pela rede
# nem tenta se auto-atualizar. Fica só aqui (arquivo protegido), não é editável pela tela.
# URL_VERIFICACAO_ATUALIZACAO=
